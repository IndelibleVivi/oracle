{
  "name": "@steipete/oracle",
  "version": "0.17.2",
  "private": true,
  "description": "CLI and MCP server for GPT-5.6 Pro through an isolated persistent Chrome profile and loopback CDP, with OpenCLI as an alternative transport.",
  "keywords": [],
  "homepage": "https://github.com/IndelibleVivi/oracle#readme",
  "bugs": {
    "url": "https://github.com/IndelibleVivi/oracle/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IndelibleVivi/oracle.git"
  },
  "bin": {
    "oracle": "dist/bin/oracle-cli.js",
    "oracle-mcp": "dist/bin/oracle-mcp.js",
    "oracle-worker": "dist/bin/oracle-worker.js"
  },
  "files": [
    "dist/**/*",
    "opencli-adapters/**/*",
    "scripts/install-opencli-submit-file-adapter.mjs",
    "assets-oracle-icon.png",
    "vendor/oracle-notifier/OracleNotifier.swift",
    "vendor/oracle-notifier/OracleNotifier.app/**",
    "vendor/oracle-notifier/build-notifier.sh",
    "assets/readme/*.svg",
    "LAUNCH.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/bin/oracle-cli.js",
  "scripts": {
    "docs:list": "tsx scripts/docs-list.ts",
    "docs:readme-sync": "node scripts/check-readme-sync.mjs",
    "docs:check": "pnpm run docs:readme-sync && node --no-deprecation --import tsx bin/oracle-cli.ts docs check",
    "docs:site": "node scripts/build-docs-site.mjs",
    "public:check": "pnpm run docs:site && node scripts/check-public-safety.mjs",
    "v2:boundaries": "node scripts/check-v2-boundaries.mjs",
    "v2:runtime-spike": "tsx scripts/oracle-v2-runtime-spike.ts",
    "v2:auth-seed-clone-proof": "tsx scripts/oracle-v2-auth-seed-clone-proof.ts",
    "v2:live-canary": "tsx scripts/oracle-v2-live-canary.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && pnpm run build:vendor && pnpm run build:bins",
    "build:bins": "node -e \"for(const file of ['dist/bin/oracle-cli.js','dist/bin/oracle-mcp.js','dist/bin/oracle-worker.js']) require('fs').chmodSync(file,0o755)\"",
    "build:vendor": "node -e \"const fs=require('fs'); const path=require('path'); const vendorRoot=path.join('dist','vendor'); fs.rmSync(vendorRoot,{recursive:true,force:true}); const vendors=[['oracle-notifier']]; vendors.forEach(([name])=>{const src=path.join('vendor',name); const dest=path.join(vendorRoot,name); fs.mkdirSync(dest,{recursive:true}); if(fs.existsSync(src)){fs.cpSync(src,dest,{recursive:true,force:true});}});\"",
    "start": "pnpm run build && node ./dist/scripts/run-cli.js",
    "oracle": "pnpm start",
    "check": "pnpm run format:check && pnpm run lint && pnpm run v2:boundaries",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:diff": "oxfmt --write . && git --no-pager diff",
    "lint": "pnpm run typecheck && oxlint",
    "lint:fix": "oxlint --fix && pnpm run format",
    "test": "pnpm run test:process-serial && pnpm run test:v2-browser-serial && pnpm run test:parallel",
    "test:process-serial": "vitest run tests/cli/brokerRootIntegration.test.ts tests/browser/dedicatedChromeSupervisor.test.ts tests/v2/oracle-browser-runtime.test.ts tests/v2/oracle-attempt-sandbox.test.ts --no-file-parallelism",
    "test:parallel": "vitest run --exclude tests/cli/brokerRootIntegration.test.ts --exclude tests/browser/dedicatedChromeSupervisor.test.ts --exclude tests/v2/oracle-browser-runtime.test.ts --exclude tests/v2/oracle-attempt-sandbox.test.ts --exclude tests/v2/chatgpt-adapter.test.ts --exclude tests/v2/oracle-worker-faults.test.ts",
    "test:v2-browser-serial": "vitest run tests/v2/chatgpt-adapter.test.ts tests/v2/oracle-worker-faults.test.ts --no-file-parallelism",
    "test:mcp": "pnpm run build && pnpm run test:mcp:unit && pnpm run test:mcp:mcporter",
    "test:mcp:unit": "vitest run tests/mcp*.test.ts tests/mcp/**/*.test.ts",
    "test:mcp:mcporter": "CHROME_DEVTOOLS_URL=http://127.0.0.1:0 pnpm dlx mcporter list oracle-local --schema --config config/mcporter.json && CHROME_DEVTOOLS_URL=http://127.0.0.1:0 pnpm dlx mcporter call oracle-local.sessions limit:1 --config config/mcporter.json",
    "test:browser": "pnpm run build && tsx scripts/test-browser.ts && ./scripts/browser-smoke.sh",
    "test:packed-cli": "node scripts/packed-cli-smoke.mjs",
    "test:live": "ORACLE_LIVE_TEST=1 vitest run tests/live --exclude tests/live/openai-live.test.ts",
    "test:live:fast": "ORACLE_LIVE_TEST=1 ORACLE_LIVE_TEST_FAST=1 vitest run tests/live/browser-fast-live.test.ts",
    "test:pro": "ORACLE_LIVE_TEST=1 vitest run tests/live/openai-live.test.ts",
    "test:coverage": "vitest run --coverage",
    "prepare": "pnpm run build",
    "mcp": "pnpm run build && node ./dist/bin/oracle-mcp.js"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@puppeteer/browsers": "^3.1.0",
    "@steipete/sweet-cookie": "^0.4.1",
    "chalk": "^6.0.0",
    "chrome-launcher": "^1.2.1",
    "chrome-remote-interface": "^0.34.0",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "gpt-tokenizer": "^3.4.0",
    "ignore": "7.0.5",
    "inquirer": "14.0.2",
    "json5": "^2.2.3",
    "kleur": "^4.1.5",
    "markdansi": "0.3.3",
    "openai": "^7.4.0",
    "osc-progress": "^0.3.2",
    "qs": "^6.15.3",
    "shiki": "^4.4.2",
    "toasted-notifier": "^10.1.0",
    "tokentally": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "devtools-protocol": "0.0.1676105",
    "es-toolkit": "^1.50.0",
    "esbuild": "^0.28.1",
    "oxfmt": "0.62.0",
    "oxlint": "^1.77.0",
    "playwright-core": "^1.62.1",
    "puppeteer-core": "^25.5.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": ">=24"
      }
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
